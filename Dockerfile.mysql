FROM mysql:8.0

# Environment variables to initialize the database and user
# These values correspond to the Django settings in todolist/settings.py
ENV MYSQL_DATABASE=app_db
ENV MYSQL_USER=app_user
ENV MYSQL_PASSWORD=1234
ENV MYSQL_ROOT_PASSWORD=rootpass

# Expose MySQL port and declare volume for persistence
EXPOSE 3306
VOLUME ["/var/lib/mysql"]
